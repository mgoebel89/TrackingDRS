# Knopf "Jetzt aktualisieren" im Lehrerbereich: der Webdienst legt /var/lib/trackingdrs/update/ausfuehren an.
[Unit]
Description=TrackingDRS: Update auf Knopfdruck

[Path]
PathExists=/var/lib/trackingdrs/update/ausfuehren
Unit=trackingdrs-update-ausfuehren.service

[Install]
WantedBy=multi-user.target
