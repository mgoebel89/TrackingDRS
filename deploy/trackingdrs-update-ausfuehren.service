# Update aus dem Lehrerbereich: Sicherung, trackingdrs-update, danach erneut pruefen (als root).
[Unit]
Description=TrackingDRS: Update ausfuehren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/trackingdrs-selbstupdate ausfuehren
TimeoutStartSec=20min
